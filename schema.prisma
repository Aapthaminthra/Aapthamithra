generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
enum Role { ADMIN EMPLOYEE CUSTOMER }
enum AccountStatus { PENDING ACTIVE REJECTED SUSPENDED }
enum VerificationStatus { NOT_STARTED PENDING VERIFIED REJECTED }
enum MembershipStatus { NONE PENDING_PAYMENT ACTIVE EXPIRED CANCELLED REFUNDED }
enum PaymentStatus { CREATED PENDING PAID FAILED REFUNDED }
enum PaymentMode { ONLINE OFFLINE }
enum ServiceRequestStatus { SUBMITTED REVIEWING ASSIGNED IN_PROGRESS COMPLETED CANCELLED }

model User {
  id                 String              @id @default(cuid())
  publicId            String?             @unique
  role                Role
  status              AccountStatus       @default(PENDING)
  fullName            String
  email               String?             @unique
  mobileE164          String
  passwordHash        String?
  verificationStatus  VerificationStatus  @default(NOT_STARTED)
  verificationType    String?
  verificationRef     String?
  approvedAt          DateTime?
  approvedById        String?
  mustChangePassword  Boolean             @default(false)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  membership          Membership?
  payments            Payment[]
  customerRequests    ServiceRequest[]    @relation("CustomerRequests")
  assignedRequests    ServiceRequest[]    @relation("AssignedEmployee")
  auditEvents         AuditEvent[]        @relation("ActorAuditEvents")
  otpChallenges       OtpChallenge[]
  @@index([role, status])
  @@index([mobileE164])
}

model Membership {
  id             String           @id @default(cuid())
  userId         String           @unique
  status         MembershipStatus @default(NONE)
  feePaise       Int              @default(99900)
  currency       String           @default("INR")
  startsAt       DateTime?
  expiresAt      DateTime?
  renewalOptIn   Boolean          @default(false)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Payment {
  id                    String        @id @default(cuid())
  userId                String
  provider              String        @default("razorpay")
  mode                  PaymentMode
  providerOrderId       String?       @unique
  providerPaymentId     String?       @unique
  amountPaise           Int           @default(99900)
  currency              String        @default("INR")
  status                PaymentStatus @default(CREATED)
  receipt               String        @unique
  offlineMethod         String?
  offlineReference      String?
  proofStorageKey       String?
  adminNote             String?
  confirmedById         String?
  confirmedAt           DateTime?
  providerSignatureOkay Boolean       @default(false)
  paidAt                DateTime?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  user                  User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  @@index([userId, status])
  @@index([mode, status])
}

model OtpChallenge {
  id          String   @id @default(cuid())
  userId      String?
  mobileE164  String
  purpose     String
  codeHash    String
  expiresAt   DateTime
  attempts    Int      @default(0)
  consumedAt  DateTime?
  createdAt   DateTime @default(now())
  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([mobileE164, purpose, createdAt])
}

model ServiceCategory {
  id          String           @id @default(cuid())
  name        String           @unique
  slug        String           @unique
  description String
  isActive    Boolean          @default(true)
  createdAt   DateTime         @default(now())
  requests    ServiceRequest[]
}

model ServiceRequest {
  id            String               @id @default(cuid())
  publicId      String               @unique
  customerId    String
  employeeId    String?
  categoryId    String
  title         String
  description   String
  locationText  String?
  status        ServiceRequestStatus @default(SUBMITTED)
  adminNotes    String?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  customer      User                 @relation("CustomerRequests", fields: [customerId], references: [id], onDelete: Restrict)
  employee      User?                @relation("AssignedEmployee", fields: [employeeId], references: [id], onDelete: SetNull)
  category      ServiceCategory      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  @@index([customerId, createdAt])
  @@index([employeeId, status])
  @@index([status, createdAt])
}

model AuditEvent {
  id          String   @id @default(cuid())
  actorId     String?
  action      String
  entityType  String
  entityId    String?
  metadata    Json?
  ipAddress   String?
  createdAt   DateTime @default(now())
  actor       User?    @relation("ActorAuditEvents", fields: [actorId], references: [id], onDelete: SetNull)
  @@index([actorId, createdAt])
  @@index([entityType, entityId])
}
